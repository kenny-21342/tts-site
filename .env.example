# Alibaba Cloud Model Studio (DashScope) API key.
# Create one at https://bailian.console.aliyun.com/ -> API-KEY.
# Never commit the real value; .env.local is gitignored.
DASHSCOPE_API_KEY=

# Recommended rewrite provider: an OpenAI-compatible gateway. AI_BASE_URL
# can be the /v1 base or the full /v1/chat/completions endpoint.
# AI_BASE_URL=https://runanytime.hxi.me/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=gpt-5.5

# Enables the "Suggest wording" step with a free API model. Create an
# OpenRouter API key at https://openrouter.ai/settings/keys and keep it
# server-side in .env.local. Free-tier usage has provider limits.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# Optional alternative: OpenCode Zen with a paid model. Its free-tier keys
# cannot call models from this site's API, only from inside OpenCode.
# OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_MODEL=

# Optional. Defaults to the mainland-China endpoint, which is the right one
# from Shanghai. The Singapore region is:
#   https://dashscope-intl.aliyuncs.com/api/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Optional. Defaults to qwen3-tts-flash.
# DASHSCOPE_TTS_MODEL=qwen3-tts-flash

# Optional. Per-IP budget for /api/tts, which spends real money per call.
# Defaults: 20000 characters and 120 requests per hour.
# TTS_CHAR_BUDGET=20000
# TTS_REQUEST_BUDGET=120
# TTS_WINDOW_MS=3600000

# Optional, and the difference between a local prototype and a public URL.
# Without these the per-IP budget is counted in one process, so on serverless
# the real limit is the budget times however many instances are warm. With
# them the count is shared and the budget means what it says.
# Provision from the Vercel Marketplace: `vercel integration add upstash`,
# which sets both of these on the project for you.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
